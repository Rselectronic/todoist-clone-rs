# Set automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# NextAuth + Convex auth
# Generate the next two by running: node generateKeys.mjs
CONVEX_AUTH_PRIVATE_KEY=
JWKS=
# Generate by running: openssl rand -base64 32
AUTH_SECRET=
CONVEX_AUTH_ADAPTER_SECRET=

# Google OAuth (Web app, redirect: /api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domain lock (override only if testing with a different domain)
RS_TASKS_ALLOWED_DOMAIN=rspcbassembly.com
